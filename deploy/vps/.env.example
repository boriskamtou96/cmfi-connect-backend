# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# The values are those of the Render service cmfi-connect-backend-dev
# (Environment tab), except the database.

# ----- the database on this server -----
# letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# the domain Caddy serves (and asks a certificate for)
API_DOMAIN=api.cmfi-connect.com
# the status page of Uptime Kuma (README, « Tableaux de bord »)
STATUS_DOMAIN=status.cmfi-connect.com
# the API of the staging, behind this Caddy (../staging/README.md)
STAGING_DOMAIN=staging-api.cmfi-connect.com

# ----- the server -----
GIN_MODE=release
LOG_LEVEL=info
PUBLIC_URL=https://api.cmfi-connect.com
CORS_ORIGINS=

# sessions: the same secret as on Render, or every member is signed out
TOKEN_SECRET=
TOKEN_DURATION=

# ----- images (Cloudflare R2) -----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
MEDIA_PUBLIC_URL=

# ----- payments -----
PAYMENT_PROVIDER=
PAYMENT_RETURN_URL=
PREMIUM_CURRENCY=
PREMIUM_PRICES_USD=
KPAY_BASE_URL=
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_WEBHOOK_SECRET=
KPAY_PROVIDERS=
KPAY_CARDS=
WAJUB_BASE_URL=
WAJUB_SECRET_KEY=
WAJUB_WEBHOOK_SECRET=
WAJUB_PROVIDERS=
WAJUB_CARDS=

# The Firebase key is not here: put the JSON file at
# /etc/cmfi/firebase-credentials.json (README).

# ----- nightly backups (backup.sh) -----
# an rclone destination for a copy off the server, e.g. r2:cmfi-backups/db
# (empty: the copies stay on this server only)
BACKUP_RCLONE_REMOTE=
