# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# The settings of production (../vps/.env), except what is written here.

# ----- the database of the staging -----
# letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# ----- the server -----
GIN_MODE=release
LOG_LEVEL=info
PUBLIC_URL=https://staging-api.cmfi-connect.com
# the admin of the staging (Cloudflare Pages, branch dev)
CORS_ORIGINS=https://dev.cmfi-connect-admin.pages.dev
# its own secret: a session of production does not open the staging
TOKEN_SECRET=
TOKEN_DURATION=

# ----- images and sounds: the bucket of the staging (a copy of production's) -----
S3_ENDPOINT=
S3_BUCKET=cmfi-connect-media-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
MEDIA_PUBLIC_URL=

# ----- payments: KPay sandbox only, Wajub off -----
PAYMENT_PROVIDER=kpay
PAYMENT_RETURN_URL=
PREMIUM_CURRENCY=
PREMIUM_PRICES_USD=
KPAY_BASE_URL=
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_WEBHOOK_SECRET=
KPAY_PROVIDERS=
KPAY_CARDS=

# The Firebase key (project cmfi-connect-dev) is not here: put the JSON file
# at /etc/cmfi/firebase-staging.json (README).
